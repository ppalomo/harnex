# macOS
.DS_Store

# Secrets and local overrides
.env
.env.*
CLAUDE.local.md
.claude/settings.local.json
# ...except the harness's own template for local visibility (docs/PLAN.md C7): source,
# not a personal instance, and must be committed like every other template.
!/plugin/context/templates/CLAUDE.local.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/

# Runtime state of a harnessed checkout (journal, manifest)
.harnex/state/

# Tool scaffolding generated by `openspec init`, regenerable, kept local.
# Anchored to the root so the .claude/ and .agents/ the template renders
# elsewhere in the tree are still tracked.
/.claude/
/.agents/
