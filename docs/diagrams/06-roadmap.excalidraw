   "roundness": null,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Later, not scheduled: real-backend calibration from the decision journal, a Codex-side guard hook,\nand a separate reviewer role. No unattended mode.",
