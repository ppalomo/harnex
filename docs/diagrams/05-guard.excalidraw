   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why this order:\n\u2022 a regex on 'rm -rf' is more reliable than\n  any model and costs nothing\n\u2022 DENY never comes from the model alone\n\u2022 the script never allows on its own error \u2192 ASK\n\u2022 if the hook itself fails, Claude Code falls\n  back to its permissions: the floor in\n  settings.json still denies or asks\n\u2022 rules with enforced_by: guard feed the\n  three pattern lists",
   "originalText": "Why this order:\n\u2022 a regex on 'rm -rf' is more reliable than\n  any model and costs nothing\n\u2022 DENY never comes from the model alone\n\u2022 the script never allows on its own error \u2192 ASK\n\u2022 if the hook itself fails, Claude Code falls\n  back to its permissions: the floor in\n  settings.json still denies or asks\n\u2022 rules with enforced_by: guard feed the\n  three pattern lists",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true
  },
  {
   "type": "text",
   "version": 1,
   "versionNonce": 643744727,
   "isDeleted": false,
   "id": "t42",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "x": 40,
   "y": 470,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "width": 354.5,
   "height": 52.5,
   "seed": 533492028,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Codex side: the codex plugin runs Codex under\nits own sandbox. A Codex hook with the same\nscript is a later feature.",
   "originalText": "Codex side: the codex plugin runs Codex under\nits own sandbox. A Codex hook with the same\nscript is a later feature.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "lineHeight": 1.25,
   "containerId": null,
