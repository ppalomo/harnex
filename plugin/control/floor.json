  "guard_only": [
    {
      "rule": "destructive-commands-ask",
      "why": "A program named by an absolute path is matched as the string it is written as, so a spelling the floor does not list escapes every prefix entry. Only the common spellings of the commonest deletion are listed; the rest needs a component that resolves the program."
    },
    {
      "rule": "destructive-commands-ask",
      "why": "An environment runner executes whatever follows it, and the host does not strip it before matching, so the inner command is never seen by a floor entry written for it."
    },
    {
      "rule": "destructive-commands-ask",
      "why": "An exec wrapper that runs its argument cannot be auto-approved or matched by a prefix rule, so what it wraps is invisible to the floor."
    },
    {
      "rule": "destructive-commands-ask",
      "why": "Whether a command is destructive often depends on the task: a deletion inside the paths a task declares is ordinary work. The floor asks in both cases; telling them apart needs a component that knows the task."
    },
    {
      "rule": "deletions-ask",
      "why": "A search command that deletes or executes through its own options hides the deletion in an argument, which a prefix entry for the search command does not cover."
    },
    {
      "rule": "credentials-never-leave-the-machine",
      "why": "Printing, committing or sending a value the process already holds is invisible to a pattern: no rule can see what a variable contains, so only a component that reads the command's intent can refuse it."
    }
  ]
